# 依赖
node_modules/

# 运行数据：内容不提交，但保留目录结构（.gitkeep）
data/*
!data/.gitkeep
!data/tts-cache/
data/tts-cache/*
!data/tts-cache/.gitkeep

# 环境变量与日志
.env
*.log

# 设计原型：不入库（仅本地参考）
*原型.html

# 系统文件
.DS_Store
Thumbs.db

# 用户自备的教学视频（体积大，放服务器上再传）
public/media/*.mp4

# 本地测试产生的临时文件
.tmppw*/
.tmppw*
_t.out
_t.err
_verify.cjs
_staged.txt
.chk_*.js

# 复制为 .env 再改（docker compose 会自动读取）

# 访问密码：设置后打开链接需先输入；留空则不校验。
# 公网部署务必设置，否则谁拿到地址都能用。
ACCESS_PASSWORD=change-me-please

# 对外端口（宿主端口，容器内部固定 3000）
PORT=3000

# 时区：影响「今日统计」按哪一天算、连续天数怎么滚
TZ=Asia/Shanghai

# 每日拼读题量目标
DAILY_TARGET=10

# 可选：指定 python 解释器（容器里默认 python3，Windows 开发机通常是 python）
# TTS_PYTHON=python3
